{
  "name": "amber",
  "version": "1.0.0",
  "private": true,
  "description": "Amber - Culture-First Job Matching",
  "author": "Nakul Patel",
  "contributors": [
    { "name": "Nakul Patel", "url": "https://github.com/nakulpatel0306" },
    { "name": "Arsh Patel", "url": "https://github.com/Arshpatel10" },
    { "name": "Neel", "url": "https://github.com/neelp04" }
  ],
  "license": "MIT",
  "homepage": "https://nakulpatel0306.github.io/amber/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nakulpatel0306/amber.git"
  },
  "workspaces": [
    "src/frontend"
  ],
  "scripts": {
    "frontend": "cd src/frontend && npm run dev",
    "backend": "cd src/backend && venv/bin/python main.py",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "cd src/frontend && npm test",
    "test:backend": "cd src/backend && venv/bin/python -m pytest",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "cd src/frontend && npm run lint",
    "lint:backend": "cd src/backend && venv/bin/ruff check .",
    "format": "npm run format:frontend && npm run format:backend",
    "format:frontend": "cd src/frontend && npm run format",
    "format:backend": "cd src/backend && venv/bin/black ."
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "job-matching",
    "culture-fit",
    "recruitment",
    "personality-assessment",
    "career"
  ]
}
