# Amber backend environment variables
# Copy to .env and fill in. These are every variable the backend reads.

# Supabase (Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server-side only: bypasses Row Level Security. Never ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Leave empty to run in dev mode, where protected routes skip auth
SUPABASE_JWT_SECRET=your-jwt-secret

# Optional: Stripe billing
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Optional: company logos through /api/logo (logo.dev)
LOGO_DEV_API_KEY=your-logo-dev-key

# Optional: where Stripe Checkout and the Customer Portal send users back to
FRONTEND_URL=http://localhost:5173
