# Amber frontend environment variables
# Copy to .env and fill in. These are every VITE_ variable the app reads.
# The demo build (npm run dev:demo / build:demo) needs none of them.

# Supabase (Project Settings > API). The anon key is public by design; RLS protects the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: FastAPI backend, defaults to http://localhost:8000
VITE_API_URL=http://localhost:8000

# Optional: Stripe price IDs for the paid plans
VITE_STRIPE_PRICE_SMOOTH_MONTHLY=price_your-id
VITE_STRIPE_PRICE_SMOOTH_YEARLY=price_your-id
VITE_STRIPE_PRICE_CONNECTOR_MONTHLY=price_your-id
VITE_STRIPE_PRICE_CONNECTOR_YEARLY=price_your-id
VITE_STRIPE_PRICE_BARISTA_MONTHLY=price_your-id
VITE_STRIPE_PRICE_BARISTA_YEARLY=price_your-id
VITE_STRIPE_PRICE_ROASTMASTER_MONTHLY=price_your-id
VITE_STRIPE_PRICE_ROASTMASTER_YEARLY=price_your-id
